ROBIS_ROBOT_IMAGE=robis:jazzy-basic
ROBIS_ROBOT_DOMAIN_ID=27
ROBIS_SIM_DOMAIN_ID=28
ROBIS_SIM_STACK=none
ROBIS_MAP_FILE=/robis_ws/data/navigation/map.yaml
# Simulation includes the local Foxglove bridge; disable if not needed.
ROBIS_FOXGLOVE_ENABLED=true
# Headless by default. For a local GUI session use: ROBIS_GZ_ARGS=-r -v 2
ROBIS_GZ_ARGS=-s -r --headless-rendering -v 2
