# Development/simulation runs on the workstation; no Nano CUDA libraries here.
FROM docker.io/library/ros:jazzy-ros-base
ENV DEBIAN_FRONTEND=noninteractive PYTHONDONTWRITEBYTECODE=1 ROS_DOMAIN_ID=28 \
    RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-colcon-common-extensions python3-opencv python3-yaml \
    python3-serial python3-transforms3d mesa-utils \
    ros-jazzy-rmw-cyclonedds-cpp ros-jazzy-rviz2 ros-jazzy-xacro ros-jazzy-robot-state-publisher \
    ros-jazzy-joint-state-publisher ros-jazzy-tf-transformations \
    ros-jazzy-ros-gz-sim ros-jazzy-ros-gz-bridge \
    ros-jazzy-navigation2 ros-jazzy-nav2-bringup ros-jazzy-slam-toolbox \
    ros-jazzy-robot-localization ros-jazzy-cv-bridge \
    ros-jazzy-message-filters ros-jazzy-vision-msgs \
    ros-jazzy-tf2-geometry-msgs ros-jazzy-ament-cmake-pytest \
    ros-jazzy-ament-flake8 python3-pytest \
    && rm -rf /var/lib/apt/lists/*
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-jazzy-foxglove-bridge \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /robis_ws
COPY config /robis_ws/config
COPY scripts /robis_ws/scripts
COPY docker/entrypoint.sh /usr/local/bin/robis-entrypoint
RUN chmod +x /usr/local/bin/robis-entrypoint /robis_ws/scripts/*.sh
ENTRYPOINT ["/usr/local/bin/robis-entrypoint"]
CMD ["bash"]
