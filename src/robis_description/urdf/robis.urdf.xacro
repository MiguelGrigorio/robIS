<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robis">

  <!-- ==========================================================
       1) ARGUMENTOS E CARREGAMENTO DO YAML
       ========================================================== -->
  <xacro:arg name="params_file" default="$(find robis_description)/config/robot_parameters.yaml"/>
  <xacro:arg name="sim_flavor" default="none"/>
  <xacro:arg name="realistic_materials" default="false"/>
  <xacro:arg name="enable_ground_truth_sensors" default="false"/>

  <xacro:property name="params_file_path" value="$(arg params_file)"/>
  <xacro:property name="sim_flavor" value="$(arg sim_flavor)"/>
  <xacro:property name="realistic_materials" value="$(arg realistic_materials)"/>
  <xacro:property name="enable_ground_truth_sensors" value="$(arg enable_ground_truth_sensors)"/>
  <xacro:property name="params" value="${xacro.load_yaml(params_file_path)}"/>
  <xacro:property name="physical" value="${params['physical']}"/>
  <xacro:property name="frames" value="${params['frames']}"/>
  <xacro:property name="lidar" value="${params['sensors']['lidar']}"/>
  <xacro:property name="camera" value="${params['sensors']['camera']}"/>

  <!-- ==========================================================
       2) ATALHOS PARA OS VALORES DO YAML
       ========================================================== -->
  <xacro:property name="chassis_radius" value="${physical['chassis_radius']}"/>
  <xacro:property name="chassis_height" value="${physical['chassis_height']}"/>
  <xacro:property name="chassis_mass" value="${physical['chassis_mass']}"/>
  <xacro:property name="ground_clearance" value="${physical['ground_clearance']}"/>
  <xacro:property name="wheel_radius" value="${physical['wheel_radius']}"/>
  <xacro:property name="wheel_width" value="${physical['wheel_width']}"/>
  <xacro:property name="wheel_track" value="${physical['wheel_track']}"/>
  <xacro:property name="wheel_mass" value="${physical['wheel_mass']}"/>
  <xacro:property name="caster_radius" value="${physical['caster_radius']}"/>
  <xacro:property name="caster_offset_x" value="${physical['caster_offset_x']}"/>
  <xacro:property name="caster_ground_gap" value="${physical['caster_ground_gap']}"/>
  <xacro:property name="caster_front_mass" value="${physical['caster_front_mass']}"/>
  <xacro:property name="caster_rear_mass" value="${physical['caster_rear_mass']}"/>
  <xacro:property name="caster_width" value="${physical['caster_width']}"/>
  <xacro:property name="caster_trail" value="${physical['caster_trail']}"/>
  <xacro:property name="caster_mount_mass_fraction" value="${physical['caster_mount_mass_fraction']}"/>
  <xacro:property name="caster_swivel_damping" value="${physical['caster_swivel_damping']}"/>
  <xacro:property name="caster_rolling_damping" value="${physical['caster_rolling_damping']}"/>
  <xacro:property name="caster_bearing_friction" value="${physical['caster_bearing_friction']}"/>
  <xacro:property name="caster_contact_friction" value="${physical['caster_contact_friction']}"/>
  <xacro:property name="lidar_tower_height" value="${physical['lidar_tower_height']}"/>
  <xacro:property name="lidar_tower_radius" value="${physical['lidar_tower_radius']}"/>
  <xacro:property name="lidar_mass" value="${physical['lidar_mass']}"/>
  <!-- The simulated optical origin must sit ahead of the CAD lens face.
       Physical-camera extrinsics remain independently calibrated. -->
  <xacro:property name="camera_offset_x" value="${camera.get('optical_origin_x', physical['camera_offset_x']) if sim_flavor == 'gz' else physical['camera_offset_x']}"/>
  <xacro:property name="camera_offset_z" value="${camera.get('optical_origin_z', physical['camera_offset_z']) if sim_flavor == 'gz' else physical['camera_offset_z']}"/>
  <xacro:property name="aruco_size_xy" value="${physical['aruco_size_xy']}"/>
  <xacro:property name="aruco_thickness" value="${physical['aruco_thickness']}"/>

  <xacro:property name="frame_base_footprint" value="${frames['base_footprint']}"/>
  <xacro:property name="frame_base_link" value="${frames['base_link']}"/>
  <xacro:property name="frame_lidar_tower" value="${frames['lidar_tower']}"/>
  <xacro:property name="frame_lidar_link" value="${frames['lidar_link']}"/>
  <xacro:property name="frame_camera_link" value="${frames['camera_link']}"/>
  <xacro:property name="frame_camera_optical" value="${frames['camera_optical_frame']}"/>
  <xacro:property name="frame_aruco_marker" value="${frames['aruco_marker']}"/>

  <!-- ==========================================================
       3) MESHES REAIS (modelados no Blender)
       ========================================================== -->

  <!-- ==========================================================
       4) MATERIAIS (cores)
       ========================================================== -->
  <material name="blue">
    <color rgba="0.17 0.42 0.69 1.0"/>
  </material>
  <material name="black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>
  <material name="dark_gray">
    <color rgba="0.15 0.15 0.15 1.0"/>
  </material>
  <material name="light_blue">
    <color rgba="0.3 0.6 0.8 1.0"/>
  </material>

  <!-- ==========================================================
       5) MACROS DE INÉRCIA
       ========================================================== -->
  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertia ixx="${m * (3 * r * r + h * h) / 12}" ixy="0" ixz="0"
             iyy="${m * (3 * r * r + h * h) / 12}" iyz="0"
             izz="${m * r * r / 2}"/>
  </xacro:macro>

  <xacro:macro name="sphere_inertia" params="m r">
    <inertia ixx="${2 * m * r * r / 5}" ixy="0" ixz="0"
             iyy="${2 * m * r * r / 5}" iyz="0"
             izz="${2 * m * r * r / 5}"/>
  </xacro:macro>

  <xacro:macro name="box_inertia" params="m x y z">
    <inertia ixx="${m * (y*y + z*z) / 12}" ixy="0" ixz="0"
             iyy="${m * (x*x + z*z) / 12}" iyz="0"
             izz="${m * (x*x + y*y) / 12}"/>
  </xacro:macro>

  <!-- ==========================================================
       6) BASE / CHASSI
       O visual atualizado agrupa as peças estáticas do CAD em body.dae,
       com materiais próprios. Rodas e casters continuam articulados.
       Os links visuais legados são preservados vazios para manter as TFs.
       Colisões, massas, inércia e referenciais dos sensores não mudaram.
       ========================================================== -->
  <link name="${frame_base_footprint}"/>

  <joint name="base_joint" type="fixed">
    <parent link="${frame_base_footprint}"/>
    <child link="${frame_base_link}"/>
    <origin xyz="0 0 ${ground_clearance}" rpy="0 0 0"/>
  </joint>

  <link name="${frame_base_link}">
    <collision>
      <geometry>
        <cylinder radius="${chassis_radius}" length="${chassis_height}"/>
      </geometry>
      <origin xyz="0 0 ${chassis_height / 2}" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="${chassis_mass}"/>
      <origin xyz="0 0 ${chassis_height / 2}" rpy="0 0 0"/>
      <xacro:cylinder_inertia m="${chassis_mass}" r="${chassis_radius}" h="${chassis_height}"/>
    </inertial>
  </link>

  <!--  Visual: chassi (azul) -->
  <joint name="chassis_visual_joint" type="fixed">
    <parent link="${frame_base_link}"/>
    <child link="chassis_visual_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="chassis_visual_link">
    <visual>
      <geometry>
        <mesh filename="file://$(find robis_description)/meshes/updated/body.dae"/>
      </geometry>
    </visual>
    <inertial>
      <mass value="0.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
  </link>

  <!-- Visual: borracha (preto) -->
  <joint name="rubber_visual_joint" type="fixed">
    <parent link="${frame_base_link}"/>
    <child link="rubber_visual_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="rubber_visual_link">
    <inertial>
      <mass value="0.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
  </link>

  <!--  Visual: marcador ArUco (light_blue)  -->
  <joint name="aruco_marker_visual_joint" type="fixed">
    <parent link="${frame_base_link}"/>
    <child link="aruco_marker_visual_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="aruco_marker_visual_link">
    <inertial>
      <mass value="0.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
  </link>

  <!-- ==========================================================
       7) RODAS MOTRIZES
       ========================================================== -->
  <xacro:macro name="wheel" params="name y_offset">
    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="${frame_base_link}"/>
      <child link="${name}_wheel"/>
      <origin xyz="0 ${y_offset} ${wheel_radius - ground_clearance}" rpy="${-pi / 2} 0 0"/>
      <axis xyz="0 0 1"/>
      <dynamics damping="0.1" friction="0.1"/>
    </joint>

    <link name="${name}_wheel">
      <visual>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
      </inertial>
    </link>
  </xacro:macro>

  <xacro:wheel name="left" y_offset="${wheel_track / 2}"/>
  <xacro:wheel name="right" y_offset="${-wheel_track / 2}"/>

  <!-- ==========================================================
       8) RODAS CASTER
       ========================================================== -->
  <xacro:macro name="caster" params="name x_offset mass">
    <xacro:property name="fork_drop" value="${ground_clearance - caster_ground_gap - caster_radius}"/>
    <xacro:property name="fork_width" value="${caster_width + 0.016}"/>
    <xacro:property name="mount_mass" value="${mass * caster_mount_mass_fraction}"/>
    <xacro:property name="roller_mass" value="${mass - mount_mass}"/>

    <!-- Passive swivel about the vertical mounting axis. -->
    <joint name="${name}_caster_joint" type="continuous">
      <parent link="${frame_base_link}"/>
      <child link="${name}_caster_swivel"/>
      <origin xyz="${x_offset} 0 0" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <dynamics damping="${caster_swivel_damping}" friction="${caster_bearing_friction}"/>
    </joint>

    <link name="${name}_caster_swivel">
      <visual>
        <origin xyz="${-caster_trail / 2} 0 -0.003"/>
        <geometry><box size="${caster_trail + 0.008} ${fork_width} 0.006"/></geometry>
        <material name="dark_gray"/>
      </visual>
      <collision>
        <origin xyz="${-caster_trail / 2} 0 -0.003"/>
        <geometry><box size="${caster_trail + 0.008} ${fork_width} 0.006"/></geometry>
      </collision>
      <visual>
        <origin xyz="${-caster_trail} ${fork_width / 2 - 0.003} ${-fork_drop / 2}"/>
        <geometry><box size="0.006 0.006 ${fork_drop}"/></geometry>
        <material name="dark_gray"/>
      </visual>
      <collision>
        <origin xyz="${-caster_trail} ${fork_width / 2 - 0.003} ${-fork_drop / 2}"/>
        <geometry><box size="0.006 0.006 ${fork_drop}"/></geometry>
      </collision>
      <visual>
        <origin xyz="${-caster_trail} ${-fork_width / 2 + 0.003} ${-fork_drop / 2}"/>
        <geometry><box size="0.006 0.006 ${fork_drop}"/></geometry>
        <material name="dark_gray"/>
      </visual>
      <collision>
        <origin xyz="${-caster_trail} ${-fork_width / 2 + 0.003} ${-fork_drop / 2}"/>
        <geometry><box size="0.006 0.006 ${fork_drop}"/></geometry>
      </collision>
      <inertial>
        <mass value="${mount_mass}"/>
        <origin xyz="${-caster_trail / 2} 0 ${-fork_drop / 2}"/>
        <xacro:box_inertia m="${mount_mass}" x="${caster_trail + 0.008}" y="${fork_width}" z="${fork_drop}"/>
      </inertial>
    </link>

    <!-- Passive rolling wheel; the offset behind the swivel creates trail. -->
    <joint name="${name}_caster_wheel_joint" type="continuous">
      <parent link="${name}_caster_swivel"/>
      <child link="${name}_caster_wheel"/>
      <origin xyz="${-caster_trail} 0 ${-fork_drop}" rpy="${-pi / 2} 0 0"/>
      <axis xyz="0 0 1"/>
      <dynamics damping="${caster_rolling_damping}" friction="${caster_bearing_friction}"/>
    </joint>
    <link name="${name}_caster_wheel">
      <visual>
        <geometry><cylinder radius="${caster_radius}" length="${caster_width}"/></geometry>
        <material name="black"/>
      </visual>
      <collision>
        <geometry><cylinder radius="${caster_radius}" length="${caster_width}"/></geometry>
      </collision>
      <inertial>
        <mass value="${roller_mass}"/>
        <xacro:cylinder_inertia m="${roller_mass}" r="${caster_radius}" h="${caster_width}"/>
      </inertial>
    </link>
  </xacro:macro>

  <xacro:caster name="front" x_offset="${caster_offset_x}"  mass="${caster_front_mass}"/>
  <xacro:caster name="rear"  x_offset="${-caster_offset_x}" mass="${caster_rear_mass}"/>

  <!-- ==========================================================
       9) TORRE DO LIDAR
       ========================================================== -->
  <joint name="lidar_tower_joint" type="fixed">
    <parent link="${frame_base_link}"/>
    <child link="${frame_lidar_tower}"/>
    <origin xyz="0.20 0 ${chassis_height}" rpy="0 0 0"/>
  </joint>

  <link name="${frame_lidar_tower}">
    <collision>
      <geometry>
        <cylinder radius="${lidar_tower_radius}" length="${lidar_tower_height}"/>
      </geometry>
      <origin xyz="0 0 ${lidar_tower_height / 2}" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="${lidar_mass}"/>
      <origin xyz="0 0 ${lidar_tower_height / 2}" rpy="0 0 0"/>
      <xacro:cylinder_inertia m="${lidar_mass}" r="${lidar_tower_radius}" h="${lidar_tower_height}"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="${frame_lidar_tower}"/>
    <child link="${frame_lidar_link}"/>
    <origin xyz="0 0 ${lidar_tower_height}" rpy="0 0 0"/>
  </joint>

  <link name="${frame_lidar_link}">
    <inertial>
      <mass value="0.1"/>
      <xacro:cylinder_inertia m="0.1" r="0.03" h="0.02"/>
    </inertial>
  </link>

  <!-- ==========================================================
       10) CÂMERA
       ========================================================== -->
  <joint name="camera_joint" type="fixed">
    <parent link="${frame_base_link}"/>
    <child link="${frame_camera_link}"/>
    <origin xyz="${camera_offset_x} 0 ${camera_offset_z}" rpy="0 0 0"/>
  </joint>

  <link name="${frame_camera_link}">
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="${frame_camera_link}"/>
    <child link="${frame_camera_optical}"/>
    <origin xyz="0 0 0" rpy="${-pi / 2} 0 ${-pi / 2}"/>
  </joint>

  <link name="${frame_camera_optical}"/>

  <!-- ==========================================================
       11) MARCADOR ARUCO (joint de posicionamento apenas — o
       visual já está no link aruco_marker_visual_link, seção 6)
       ========================================================== -->
  <joint name="aruco_joint" type="fixed">
    <parent link="${frame_base_link}"/>
    <child link="${frame_aruco_marker}"/>
    <origin xyz="0 0 ${chassis_height}" rpy="0 0 0"/>
  </joint>

  <link name="${frame_aruco_marker}"/>

  <!-- ==========================================================
       12) GAZEBO SIM (só entra com sim_flavor:=gz)
       ========================================================== -->
  <xacro:if value="${sim_flavor == 'gz'}">

    <xacro:if value="${realistic_materials}">
      <gazebo reference="chassis_visual_link">
        <visual>
        </visual>
      </gazebo>
      <gazebo reference="rubber_visual_link">
        <visual>
        </visual>
      </gazebo>
    </xacro:if>

    <gazebo>
      <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
        <topic>/joint_states</topic>
      </plugin>
      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>${wheel_track}</wheel_separation>
        <wheel_radius>${wheel_radius}</wheel_radius>
        <topic>/cmd_vel</topic>
        <odom_topic>/odom</odom_topic>
        <tf_topic>/tf</tf_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>${frame_base_footprint}</child_frame_id>
      </plugin>
      <!-- <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
        <render_engine>ogre2</render_engine>
      </plugin> -->
    </gazebo>

    <gazebo reference="${frame_lidar_link}">
      <sensor type="gpu_lidar" name="ydlidar">
        <always_on>true</always_on>
        <visualize>true</visualize>
        <topic>/scan</topic>
        <gz_frame_id>${frame_lidar_link}</gz_frame_id>
        <update_rate>${lidar['update_rate']}</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>${lidar['samples']}</samples>
              <resolution>1</resolution>
              <min_angle>${lidar['min_angle']}</min_angle>
              <max_angle>${lidar['max_angle']}</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>${lidar['range_min']}</min>
            <max>${lidar['range_max']}</max>
            <resolution>${lidar['range_resolution']}</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>${lidar['noise_stddev']}</stddev>
          </noise>
        </ray>
      </sensor>
    </gazebo>

    <gazebo reference="${frame_camera_link}">
      <sensor type="camera" name="camera">
        <always_on>true</always_on>
        <visualize>true</visualize>
        <topic>/camera/image_raw</topic>
        <gz_frame_id>${frame_camera_optical}</gz_frame_id>
        <update_rate>${camera['update_rate']}</update_rate>
        <camera name="webcam">
          <camera_info_topic>/camera/camera_info</camera_info_topic>
          <horizontal_fov>${camera['horizontal_fov']}</horizontal_fov>
          <image>
            <width>${camera['width']}</width>
            <height>${camera['height']}</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>${camera['near_clip']}</near>
            <far>${camera['far_clip']}</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>${camera['noise_stddev']}</stddev>
          </noise>
        </camera>
      </sensor>
    </gazebo>

    <!-- Research-only dense depth and semantic labels. The production path
         remains the RGB camera plus the planar lidar above. -->
    <xacro:if value="${enable_ground_truth_sensors}">
      <gazebo reference="${frame_camera_link}">
        <sensor type="rgbd_camera" name="ground_truth_rgbd">
          <always_on>true</always_on>
          <visualize>false</visualize>
          <topic>/camera/rgbd</topic>
          <update_rate>10</update_rate>
          <camera name="ground_truth_rgbd_camera">
            <horizontal_fov>${camera['horizontal_fov']}</horizontal_fov>
            <image>
              <width>${camera['width']}</width>
              <height>${camera['height']}</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>${camera['near_clip']}</near>
              <far>${camera['far_clip']}</far>
            </clip>
          </camera>
        </sensor>
        <sensor type="segmentation" name="semantic_camera">
          <always_on>true</always_on>
          <visualize>false</visualize>
          <topic>/camera/semantic</topic>
          <update_rate>10</update_rate>
          <camera>
            <segmentation_type>semantic</segmentation_type>
            <horizontal_fov>${camera['horizontal_fov']}</horizontal_fov>
            <image>
              <width>${camera['width']}</width>
              <height>${camera['height']}</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>${camera['near_clip']}</near>
              <far>${camera['far_clip']}</far>
            </clip>
          </camera>
        </sensor>
      </gazebo>
    </xacro:if>

    <gazebo reference="left_wheel">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
    </gazebo>

    <gazebo reference="right_wheel">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
    </gazebo>

    <gazebo reference="front_caster_wheel">
      <mu1>${caster_contact_friction}</mu1>
      <mu2>${caster_contact_friction}</mu2>
    </gazebo>

    <gazebo reference="rear_caster_wheel">
      <mu1>${caster_contact_friction}</mu1>
      <mu2>${caster_contact_friction}</mu2>
    </gazebo>
  </xacro:if>
</robot>
