<?xml version="1.0"?>
<sdf version="1.9">
  <world name="ball_follower_test">
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Borders to contain the robot -->
    <model name="walls">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="walls_link">
        <!-- North wall -->
        <collision name="north_wall_collision">
          <pose>0 4.5 0.5 0 0 0</pose>
          <geometry>
            <box>
              <size>9 0.2 1</size>
            </box>
          </geometry>
        </collision>
        <visual name="north_wall_visual">
          <pose>0 4.5 0.5 0 0 0</pose>
          <geometry>
            <box>
              <size>9 0.2 1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.75 0.75 0.75 1</ambient>
            <diffuse>0.75 0.75 0.75 1</diffuse>
          </material>
        </visual>

        <!-- South wall -->
        <collision name="south_wall_collision">
          <pose>0 -4.5 0.5 0 0 0</pose>
          <geometry>
            <box>
              <size>9 0.2 1</size>
            </box>
          </geometry>
        </collision>
        <visual name="south_wall_visual">
          <pose>0 -4.5 0.5 0 0 0</pose>
          <geometry>
            <box>
              <size>9 0.2 1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.75 0.75 0.75 1</ambient>
            <diffuse>0.75 0.75 0.75 1</diffuse>
          </material>
        </visual>

        <!-- East wall -->
        <collision name="east_wall_collision">
          <pose>4.5 0 0.5 0 0 0</pose>
          <geometry>
            <box>
              <size>0.2 9 1</size>
            </box>
          </geometry>
        </collision>
        <visual name="east_wall_visual">
          <pose>4.5 0 0.5 0 0 0</pose>
          <geometry>
            <box>
              <size>0.2 9 1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.75 0.75 0.75 1</ambient>
            <diffuse>0.75 0.75 0.75 1</diffuse>
          </material>
        </visual>

        <!-- West wall -->
        <collision name="west_wall_collision">
          <pose>-4.5 0 0.5 0 0 0</pose>
          <geometry>
            <box>
              <size>0.2 9 1</size>
            </box>
          </geometry>
        </collision>
        <visual name="west_wall_visual">
          <pose>-4.5 0 0.5 0 0 0</pose>
          <geometry>
            <box>
              <size>0.2 9 1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.75 0.75 0.75 1</ambient>
            <diffuse>0.75 0.75 0.75 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Orange ball for the follower to track -->
    <model name="orange_ball">
      <static>false</static>
      <pose>1.5 0 0.15 0 0 0</pose>
      <link name="ball_link">
        <collision name="ball_collision">
          <geometry>
            <sphere>
              <radius>0.15</radius>
            </sphere>
          </geometry>
        </collision>
        <visual name="ball_visual">
          <geometry>
            <sphere>
              <radius>0.15</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>1.0 0.35 0.02 1</ambient>
            <diffuse>1.0 0.35 0.02 1</diffuse>
            <specular>0.2 0.1 0.02 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Optional: some obstacles for more interesting testing -->
    <model name="obstacle_1">
      <static>true</static>
      <pose>-2.0 -2.0 0.3 0 0 0</pose>
      <link name="obstacle_link">
        <collision name="obstacle_collision">
          <geometry>
            <box>
              <size>0.4 0.4 0.6</size>
            </box>
          </geometry>
        </collision>
        <visual name="obstacle_visual">
          <geometry>
            <box>
              <size>0.4 0.4 0.6</size>
            </box>
          </geometry>
          <material>
            <ambient>0.45 0.56 0.72 1</ambient>
            <diffuse>0.45 0.56 0.72 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>