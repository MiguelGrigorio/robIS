<?xml version="1.0"?>
<sdf version="1.9">
  <world name="semantic_hall">
    <gravity>0 0 -9.8</gravity>
    <physics name="semantic_hall_physics" type="ignored">
      <max_step_size>0.005</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose><cast_shadows>true</cast_shadows>
      <diffuse>0.95 0.95 0.95 1</diffuse><direction>-0.4 0.2 -1</direction>
    </light>

    <model name="floor"><static>true</static><link name="link">
      <collision name="floor"><geometry><plane><normal>0 0 1</normal><size>18 14</size></plane></geometry></collision>
      <visual name="floor"><geometry><plane><normal>0 0 1</normal><size>18 14</size></plane></geometry>
        <material><diffuse>0.72 0.74 0.76 1</diffuse></material></visual>
    </link></model>

    <!-- Hall aberto 18 x 14 m para campanhas semânticas determinísticas. -->
    <model name="walls"><static>true</static><link name="walls">
      <collision name="north"><pose>0 7 1 0 0 0</pose><geometry><box><size>18 0.2 2</size></box></geometry></collision>
      <visual name="north"><pose>0 7 1 0 0 0</pose><geometry><box><size>18 0.2 2</size></box></geometry></visual>
      <collision name="south"><pose>0 -7 1 0 0 0</pose><geometry><box><size>18 0.2 2</size></box></geometry></collision>
      <visual name="south"><pose>0 -7 1 0 0 0</pose><geometry><box><size>18 0.2 2</size></box></geometry></visual>
      <collision name="east"><pose>9 0 1 0 0 0</pose><geometry><box><size>0.2 14 2</size></box></geometry></collision>
      <visual name="east"><pose>9 0 1 0 0 0</pose><geometry><box><size>0.2 14 2</size></box></geometry></visual>
      <collision name="west"><pose>-9 0 1 0 0 0</pose><geometry><box><size>0.2 14 2</size></box></geometry></collision>
      <visual name="west"><pose>-9 0 1 0 0 0</pose><geometry><box><size>0.2 14 2</size></box></geometry></visual>

    </link></model>

    <!-- Labels: 1 chair, 2 couch, 3 dining table, 4 bed, 5 toilet. -->
    <model name="chair_east"><static>true</static><pose>6 4.6 0 0 0 3.14</pose>
      <plugin filename="gz-sim-label-system" name="gz::sim::systems::Label"><label>1</label></plugin>
      <include merge="true"><uri>model://robis_chair</uri></include>
    </model>
    <model name="chair_west"><static>true</static><pose>-3.5 -4.5 0 0 0 0</pose>
      <plugin filename="gz-sim-label-system" name="gz::sim::systems::Label"><label>1</label></plugin>
      <include merge="true"><uri>model://robis_chair</uri></include>
    </model>
    <model name="couch"><static>true</static><pose>-7.0 4.6 0 0 0 0</pose>
      <plugin filename="gz-sim-label-system" name="gz::sim::systems::Label"><label>2</label></plugin>
      <include merge="true"><uri>model://robis_sofa</uri></include>
    </model>
    <model name="dining_table"><static>true</static><pose>5.5 -4.5 0 0 0 0</pose>
      <plugin filename="gz-sim-label-system" name="gz::sim::systems::Label"><label>3</label></plugin>
      <include merge="true"><uri>model://robis_table</uri></include>
    </model>
    <model name="bed"><static>true</static><pose>-3.2 4.6 0 0 0 1.57</pose>
      <plugin filename="gz-sim-label-system" name="gz::sim::systems::Label"><label>4</label></plugin>
      <include merge="true"><uri>model://robis_bed</uri></include>
    </model>
    <model name="toilet"><static>true</static><pose>-7.0 -4.8 0 0 0 1.57</pose>
      <plugin filename="gz-sim-label-system" name="gz::sim::systems::Label"><label>5</label></plugin>
      <include merge="true"><uri>model://robis_toilet</uri></include>
    </model>
  </world>
</sdf>
